metals = {'K', 'Au', 'Ag', 'Cu'};
compare_metals_simple(metals, 0.020, 0.9, 1.5, 1.5);

sizes = [0.005, 0.010, 0.020, 0.030, 0.050];
study_size_effects('Au', sizes, 0.9, 1.5, 1.5);

%%
enhanced_material_comparison(metals, 0.020, 0.9, 1.5, 1.5);

%%

function [C, Ls, peak_wavelengths] = calculate_lsp_spectrum(metal, a, f, nc, nb)
% Calculate LSP spectrum for given parameters
% Inputs:
%   metal - string: 'Au', 'Ag', 'K', 'Cu', 'Al'
%   a - sphere radius in microns
%   f - metal fraction (0-1)
%   nc - core refractive index
%   nb - background refractive index
% Outputs:
%   C - cross-sections [ext, abs, sca]
%   Ls - energy scale in eV
%   peak_wavelengths - resonance wavelengths

% Get material data
[et,Lt]=feval(['eps',metal]);
Lmin = min(Lt);
Lmin = min(Lt(real(et)<0));
eV = 1.24*linspace(0,1,1e3).'/Lmin;
eV = eV(eV>0);
L = 1.24./eV;

% Setup particle
N=10;
fm=['eps',metal];
m=[nc*ones(size(L)), sqrt(feval(fm,L)), nb*ones(size(L))];
av = a*[(1-f)^(1/3), 1];
vol=4*pi/3*a^3;
mu=ones(size(m));

% Calculate spectrum
C=nan([length(L),3]);
Ls=nan(size(L));
fx=@(x) 1.24./x; % convert to eV

for k=1:length(L)
    L1=L(k);
    coeffs=fmiecoeff(N, L1, av, m(k,:), mu(k,:));
    C1=crosssection(coeffs, L1, av, m(k,:));
    C1=C1/vol/(2*pi/L1); % normalize by volume and k
    C(k,:)=C1;
    Ls(k)=fx(L(k));
end

% Find peak wavelengths
[~,ind]=max(C);
peak_wavelengths = 1.24./Ls(ind); % convert back to wavelengths in microns

end

function enhanced_material_comparison(metals, a, f, nc, nb)
% Enhanced comparison with theoretical predictions
% metals - cell array: {'K', 'Au', 'Ag', 'Cu', 'Al'}

% Get theoretical plasma frequencies (from material files)
plasma_freqs = containers.Map({'K', 'Au', 'Ag', 'Cu', 'Al'}, ...
                             {3.95, 8.4, 9.07, 8.95, 11.49}); % eV

figure('Position', [100, 100, 1200, 800]);
colors = lines(length(metals));
results_table = {};

% Theory prediction: omega_sphere = omega_p / sqrt(1 + 2*epsilon_b)
% For nb=1.5: epsilon_b = 1.5^2 = 2.25
theory_factor = sqrt(1 + 2*nb^2);

for i = 1:length(metals)
    [C, Ls, peaks] = calculate_lsp_spectrum(metals{i}, a, f, nc, nb);
    
    % Plot experimental spectrum
    subplot(2,2,1)
    plot(Ls, C(:,1), 'Color', colors(i,:), 'LineWidth', 2);
    hold on;
    
    % Theoretical prediction
    omega_p = plasma_freqs(metals{i});
    omega_theory = omega_p / theory_factor;
    
    % Mark theoretical prediction
    plot(omega_theory, max(C(:,1))*0.5, 'v', 'Color', colors(i,:), ...
         'MarkerSize', 10, 'MarkerFaceColor', colors(i,:));
    
    % Store results
    experimental_peak = 1.24/peaks(1); % convert eV to microns, then to nm
    theoretical_peak = 1.24/omega_theory;
    error_percent = abs(experimental_peak - theoretical_peak)/theoretical_peak * 100;
    
    results_table{end+1} = {metals{i}, omega_p, omega_theory, ...
                           1.24/Ls(find(C(:,1) == max(C(:,1)), 1)), ...
                           theoretical_peak*1000, experimental_peak*1000, error_percent};
end

% Format main spectrum plot
subplot(2,2,1)
xlabel('Energy (eV)');
ylabel('Extinction C/V/k');
title('LSP Resonances: Theory vs Experiment');
legend([metals, strcat(metals, '-theory')], 'Location', 'best');
grid on;

% Theory vs experiment comparison
subplot(2,2,2)
theory_peaks = cellfun(@(x) x{5}, results_table);
exp_peaks = cellfun(@(x) x{6}, results_table);
plot(theory_peaks, exp_peaks, 'ro', 'MarkerSize', 10, 'LineWidth', 2);
hold on;
plot([min(theory_peaks), max(theory_peaks)], [min(theory_peaks), max(theory_peaks)], 'k--');
xlabel('Theoretical Peak (nm)');
ylabel('Experimental Peak (nm)');
title('Theory vs Experiment');
for i = 1:length(metals)
    text(theory_peaks(i), exp_peaks(i), ['  ', metals{i}]);
end
grid on;

% Absorption vs scattering analysis
subplot(2,2,3)
for i = 1:length(metals)
    [C, Ls, ~] = calculate_lsp_spectrum(metals{i}, a, f, nc, nb);
    abs_sca_ratio = C(:,2)./C(:,3); % absorption/scattering ratio
    plot(Ls, abs_sca_ratio, 'Color', colors(i,:), 'LineWidth', 2);
    hold on;
end
xlabel('Energy (eV)');
ylabel('Absorption/Scattering Ratio');
title('Size Parameter Effects');
legend(metals, 'Location', 'best');
grid on;

% Results table - simplified
subplot(2,2,4)
axis off;
table_str = sprintf('%-6s %-8s %-8s %-8s\n', 'Metal', 'Theory(nm)', 'Exp(nm)', 'Error(%)');
table_str = [table_str, repmat('-', 1, 35), sprintf('\n')];
for i = 1:length(results_table)
    table_str = [table_str, sprintf('%-6s %-8.0f %-8.0f %-8.1f\n', ...
                results_table{i}{1}, results_table{i}{5}, results_table{i}{6}, results_table{i}{7})];
end
text(0.05, 0.7, table_str, 'FontSize', 11, 'VerticalAlignment', 'top');
title('Quantitative Comparison');

% Print analysis
fprintf('\n=== LSP MATERIAL ANALYSIS ===\n');
fprintf('Theoretical model: ω = ωp/√(1+2εb) with εb = %.2f\n', nb^2);
fprintf('\nResults Summary:\n');
for i = 1:length(results_table)
    fprintf('%s: Theory %.0f nm, Experiment %.0f nm, Error %.1f%%\n', ...
            results_table{i}{1}, results_table{i}{5}, results_table{i}{6}, results_table{i}{7});
end

end

function compare_metals_simple(metals, a, f, nc, nb)
% Simpler comparison function without advanced analysis
figure('Position', [100, 100, 1000, 600]);
colors = lines(length(metals));

for i = 1:length(metals)
    [C, Ls, peaks] = calculate_lsp_spectrum(metals{i}, a, f, nc, nb);
    
    subplot(1,2,1)
    plot(Ls, C(:,1), 'Color', colors(i,:), 'LineWidth', 2);
    hold on;
    
    subplot(1,2,2)
    plot(Ls, C(:,2), '-', 'Color', colors(i,:), 'LineWidth', 2);
    hold on;
    plot(Ls, C(:,3), '--', 'Color', colors(i,:), 'LineWidth', 2);
    hold on;
    
    % Print peak info
    fprintf('%s: Peak at %.2f eV (%.0f nm)\n', metals{i}, ...
            Ls(find(C(:,1) == max(C(:,1)), 1)), 1240/Ls(find(C(:,1) == max(C(:,1)), 1)));
end

% Format plots
subplot(1,2,1)
xlabel('Energy (eV)');
ylabel('Extinction Cross-section');
title('LSP Extinction Spectra');
legend(metals, 'Location', 'best');
grid on;

subplot(1,2,2)
xlabel('Energy (eV)');
ylabel('Cross-section');
title('Absorption (solid) vs Scattering (dashed)');
legend_entries = {};
for i = 1:length(metals)
    legend_entries{end+1} = [metals{i} '-abs'];
    legend_entries{end+1} = [metals{i} '-sca'];
end
grid on;

end

function study_size_effects(metal, sizes, f, nc, nb)
% Study how particle size affects LSP resonance
figure('Position', [100, 100, 800, 600]);
colors = jet(length(sizes));

peak_data = [];
for i = 1:length(sizes)
    [C, Ls, peaks] = calculate_lsp_spectrum(metal, sizes(i), f, nc, nb);
    
    plot(Ls, C(:,1), 'Color', colors(i,:), 'LineWidth', 2);
    hold on;
    
    % Store peak info
    peak_wavelength = 1240/Ls(find(C(:,1) == max(C(:,1)), 1));
    peak_data = [peak_data; sizes(i)*1000, peak_wavelength]; % radius in nm, wavelength in nm
end

xlabel('Energy (eV)');
ylabel('Extinction C/V/k');
title(sprintf('%s LSP: Size Effects', metal));
legend(arrayfun(@(x) sprintf('r=%.0fnm', x*1000), sizes, 'UniformOutput', false), 'Location', 'best');
grid on;

% Show size independence
figure;
plot(peak_data(:,1), peak_data(:,2), 'bo-', 'LineWidth', 2, 'MarkerSize', 8);
xlabel('Particle Radius (nm)');
ylabel('Peak Wavelength (nm)');
title(sprintf('%s LSP: Peak Position vs Size', metal));
grid on;

fprintf('\n=== SIZE EFFECT ANALYSIS ===\n');
fprintf('Metal: %s\n', metal);
fprintf('Size independence test:\n');
for i = 1:size(peak_data,1)
    fprintf('r = %.0f nm: λ = %.0f nm\n', peak_data(i,1), peak_data(i,2));
end
wavelength_std = std(peak_data(:,2));
fprintf('Standard deviation: %.1f nm (%.1f%% of mean)\n', wavelength_std, wavelength_std/mean(peak_data(:,2))*100);

end